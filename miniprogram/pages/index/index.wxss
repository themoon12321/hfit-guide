.page {
  padding: 40rpx 32rpx 60rpx;
}

/* ===== 星空流星（与网页版一致） ===== */
.star-field {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
}
.star {
  position: absolute;
  border-radius: 50%;
  background: #fff;
  opacity: 0.3;
  animation: starTwinkle ease-in-out infinite alternate;
}
@keyframes starTwinkle {
  from { opacity: 0.12; transform: scale(0.8); }
  to { opacity: 0.95; transform: scale(1.15); }
}
.meteor {
  position: absolute;
  width: 200rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(255,255,255,0.95), rgba(255,255,255,0.4) 30%, transparent);
  transform: rotate(-35deg);
  opacity: 0;
  animation: meteorFall linear infinite;
}
@keyframes meteorFall {
  0%   { transform: translate(0, 0) rotate(-35deg); opacity: 0; }
  8%   { opacity: 1; }
  92%  { opacity: 1; }
  100% { transform: translate(-600rpx, 420rpx) rotate(-35deg); opacity: 0; }
}

/* 内容浮于星空之上 */
.content {
  position: relative;
  z-index: 1;
}

.hero {
  text-align: center;
  padding: 40rpx 0 48rpx;
}
.hero .badge {
  display: inline-block;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.07);
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 28rpx;
}
.hero .title {
  font-size: 52rpx;
  font-weight: 650;
  color: #f5f5fa;
  letter-spacing: -0.5rpx;
  margin-bottom: 18rpx;
}
.hero .sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.45);
  line-height: 1.7;
}
.hero .notice {
  margin-top: 28rpx;
  font-size: 21rpx;
  color: rgba(255,255,255,0.3);
  line-height: 1.6;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.entry {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.entry:active {
  background: rgba(255,255,255,0.09);
}
.entry .icon {
  font-size: 40rpx;
  margin-bottom: 14rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}
.entry .name {
  font-size: 26rpx;
  font-weight: 600;
  color: #f0f0f5;
  margin-bottom: 6rpx;
}
.entry .desc {
  font-size: 20rpx;
  color: rgba(255,255,255,0.35);
}

.footer {
  text-align: center;
  margin-top: 60rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.15);
  letter-spacing: 0.5rpx;
}
