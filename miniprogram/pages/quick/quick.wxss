.page {
  padding: 32rpx 28rpx 60rpx;
}

.head {
  margin-bottom: 28rpx;
}
.head .title {
  font-size: 40rpx;
  font-weight: 650;
  color: #f5f5fa;
  margin-bottom: 10rpx;
}
.head .sub {
  font-size: 23rpx;
  color: rgba(255,255,255,0.35);
}

.q-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.q-item {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
}
.q-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}
.q-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #f0f0f5;
}
.q-value {
  font-size: 27rpx;
  font-weight: 650;
  color: #4cd964;
  font-feature-settings: "tnum";
  text-align: right;
}
.q-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  line-height: 1.6;
}

.tip {
  margin-top: 32rpx;
  font-size: 21rpx;
  color: rgba(255,255,255,0.25);
  text-align: center;
}
