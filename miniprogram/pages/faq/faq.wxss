.page {
  padding: 28rpx 24rpx 60rpx;
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255,200,60,0.06);
  border: 1px solid rgba(255,200,60,0.12);
  font-size: 21rpx;
  color: rgba(255,215,110,0.55);
  line-height: 1.6;
  margin-bottom: 12rpx;
}
.updated {
  font-size: 20rpx;
  color: rgba(255,255,255,0.2);
  margin: 0 6rpx 20rpx;
  font-feature-settings: "tnum";
}

.item {
  border-radius: 20rpx;
  border: 1px solid rgba(255,255,255,0.06);
  overflow: hidden;
  margin-bottom: 14rpx;
  background: rgba(255,255,255,0.02);
}
.q {
  padding: 26rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.q-mark {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.2);
  flex-shrink: 0;
  width: 36rpx;
}
.q-text {
  font-size: 27rpx;
  font-weight: 600;
  color: #f0f0f5;
  flex: 1;
  line-height: 1.5;
}
.arrow {
  font-size: 26rpx;
  color: rgba(255,255,255,0.15);
  transition: transform 0.25s;
  flex-shrink: 0;
}
.arrow.open {
  transform: rotate(90deg);
}

.a {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
}
.a.open {
  max-height: 720rpx;
  overflow-y: auto;
}
.a rich-text {
  display: block;
  padding: 0 26rpx 0 76rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.8;
}
.a .imgs {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 14rpx 26rpx 0 76rpx;
}
.a .imgs image {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(255,255,255,0.06);
}
.a .tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  padding: 14rpx 26rpx 22rpx 76rpx;
}
.a .tag {
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.05);
  font-size: 19rpx;
  color: rgba(255,255,255,0.3);
}
