<view class="page">
  <view class="notice">⚠️ 以下内容仅根据个人经验回答，仅供参考，实际以学校规定为准。</view>
  <view class="updated">内容最后更新：{{updated}}</view>

  <view class="item" wx:for="{{list}}" wx:key="id">
    <view class="q" bindtap="toggle" data-index="{{index}}">
      <view class="q-mark">Q</view>
      <view class="q-text">{{item.q}}</view>
      <view class="arrow {{openIndex === index ? 'open' : ''}}">›</view>
    </view>
    <view class="a {{openIndex === index ? 'open' : ''}}">
      <rich-text nodes="{{item.aHtml}}"></rich-text>
      <view class="imgs" wx:if="{{item.images.length}}">
        <image
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          lazy-load
          bindtap="previewImg"
          data-src="{{img}}"
        />
      </view>
      <view class="tags">
        <view class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">#{{t}}</view>
      </view>
    </view>
  </view>
</view>
