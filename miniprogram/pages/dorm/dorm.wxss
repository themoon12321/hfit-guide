.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 20rpx 0 24rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  padding: 0 24rpx;
  flex-shrink: 0;
}
.tab {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  color: rgba(255,255,255,0.4);
  font-size: 21rpx;
}
.tab.active {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.16);
  color: rgba(255,255,255,0.85);
}

.gallery {
  flex: 1;
  min-height: 0;
  margin: 16rpx 0;
}
.main-img {
  width: 100%;
  height: 100%;
}

.label {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  padding: 0 24rpx 14rpx;
  flex-shrink: 0;
}

.thumbs {
  white-space: nowrap;
  padding: 6rpx 0;
  flex-shrink: 0;
}
.thumb {
  display: inline-block;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 8rpx;
  border: 2rpx solid rgba(255,255,255,0.12);
  vertical-align: middle;
}
.thumb image {
  width: 100%;
  height: 100%;
}
.thumb.active {
  border-color: #4cd964;
}
