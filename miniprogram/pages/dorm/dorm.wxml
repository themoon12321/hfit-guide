<view class="page">
  <view class="tabs">
    <view class="tab {{cat === '' ? 'active' : ''}}" bindtap="setCat" data-cat="">全部</view>
    <view class="tab {{cat === 'desk' ? 'active' : ''}}" bindtap="setCat" data-cat="desk">书桌</view>
    <view class="tab {{cat === 'bed' ? 'active' : ''}}" bindtap="setCat" data-cat="bed">床</view>
    <view class="tab {{cat === 'stairs' ? 'active' : ''}}" bindtap="setCat" data-cat="stairs">楼梯</view>
    <view class="tab {{cat === 'closet' ? 'active' : ''}}" bindtap="setCat" data-cat="closet">衣柜</view>
    <view class="tab {{cat === 'space' ? 'active' : ''}}" bindtap="setCat" data-cat="space">空间</view>
  </view>

  <swiper class="gallery" current="{{current}}" bindchange="onChange">
    <swiper-item wx:for="{{list}}" wx:key="id">
      <image
        class="main-img"
        src="{{item.src}}"
        mode="aspectFit"
        bindtap="preview"
      />
    </swiper-item>
  </swiper>

  <scroll-view class="thumbs" scroll-x scroll-into-view="thumb-{{current}}" scroll-with-animation>
    <view
      class="thumb {{current === index ? 'active' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      id="thumb-{{index}}"
      bindtap="goTo"
      data-index="{{index}}"
    >
      <image src="{{item.thumb}}" mode="aspectFill" lazy-load />
    </view>
  </scroll-view>

  <view class="label">{{list[current].label}}</view>
</view>
